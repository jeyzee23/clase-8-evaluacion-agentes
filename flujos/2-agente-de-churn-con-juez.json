    {
      "parameters": {
        "jsCode": "// SELF-HEALING: le devolvemos al agente las críticas del Juez para que corrija.\nconst v = $input.first().json;  // el veredicto que devolvió el Juez\nconst errores = v.errores.map(e => '- ' + e).join('\\n');\n\nreturn [{ json: {\n  contexto: v.contexto,\n  feedback: `\\n\\nTU RESPUESTA ANTERIOR FUE OBSERVADA POR EL JUEZ (${v.score}/10). ` +\n            `Generá una versión nueva corrigiendo estos puntos:\\n${errores}`,\n} }];\n"
      },
