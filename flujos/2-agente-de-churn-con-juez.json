      "parameters": {
        "jsCode": "// TRAZABILIDAD: el Juez necesita saber qué sabía el agente y qué respondió.\nconst s = $('Health score + prioridad').first().json;\nconst agente = $input.first().json;  // lo que acaba de responder el agente\n\nreturn [{ json: {\n  contexto: s.contexto,               // las señales que recibió el agente\n  respuesta_agente: agente.output,    // lo que respondió\n  intento: $runIndex,            // 0 = primera respuesta · 1 y 2 = reintentos\n} }];\n"
      },
